includes:
    - vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - app/

    # Level 9 is the highest level
    level: 5

    parallel:
        maximumNumberOfProcesses: 2

    stubFiles:
        - app/Support/PHPStan/filament-macros.stub

