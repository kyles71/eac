{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "codewithdennis/larament",
    "type": "project",
    "description": "Larament is a time-saving starter kit to quickly launch Laravel 12.x projects. It includes FilamentPHP 4.x pre-installed and configured, along with additional tools and features to streamline your development workflow.",
    "keywords": [
        "laravel",
        "framework",
        "filamentphp",
        "starter-kit",
        "larament"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "bezhansalleh/filament-panel-switch": "^3.0",
        "bezhansalleh/filament-shield": "^4.0",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "filament/spatie-laravel-settings-plugin": "^5.0",
        "filament/spatie-laravel-tags-plugin": "^5.0",
        "guava/filament-icon-picker": "^4.0",
        "kyle/filament-mail-manager": "*",
        "kyle/filament-theme-builder": "*",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.34",
        "nunomaduro/essentials": "^1.0",
        "saade/filament-fullcalendar": "^4.0",
        "sentry/sentry-laravel": "^4.25",
        "spatie/laravel-backup": "^10.0",
        "stripe/stripe-php": "^19.4",
        "textmagic/textmagic-rest-php-v2": "^3.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "deployer/deployer": "^7.5",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.2",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^v5.0",
        "pestphp/pest-plugin-browser": "v5.0",
        "pestphp/pest-plugin-faker": "^v5.0",
        "pestphp/pest-plugin-laravel": "^v5.0",
        "pestphp/pest-plugin-livewire": "^v5.0",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:kyles71/filament-mail-manager.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:kyles71/filament-themes.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan app:welcome",
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi",
            "@php artisan db:seed --ansi",
            "npm install",
            "npm install playwright@latest",
            "npx playwright install",
            "npm run build",
            "@php cleanup.php"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "pest": "./vendor/bin/pest --parallel",
        "rector": "./vendor/bin/rector process --ansi",
        "pint": "./vendor/bin/pint",
        "phpstan": "./vendor/bin/phpstan analyse --memory-limit=2G",
        "review": [
            "@pint",
            "@rector",
            "@phpstan",
            "@pest"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}