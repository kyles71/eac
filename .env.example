APP_NAME="EAC Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=America/New_York
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=7
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SENTRY_LARAVEL_DSN=null
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=null

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_PUBLIC_DISK=public
MEDIA_PRIVATE_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TRANSACTIONAL_TRANSPORT=log
MAIL_HANDCRAFTED_TRANSPORT=log
MAIL_HANDCRAFTED_ARCHIVE_TO=
MAIL_PAYMENT_PLAN_PAST_DUE_RECIPIENT=
MAIL_PRODUCT_PURCHASE_RECIPIENT=

TEXTMAGIC_USERNAME=
TEXTMAGIC_API_KEY=
TEXTMAGIC_TRANSACTIONAL_EMAIL_SENDER_ID=
TEXTMAGIC_TRANSACTIONAL_FROM_NAME=
TEXTMAGIC_TRANSACTIONAL_REPLY_TO=
TEXTMAGIC_HANDCRAFTED_EMAIL_SENDER_ID=
TEXTMAGIC_HANDCRAFTED_FROM_NAME=
TEXTMAGIC_HANDCRAFTED_REPLY_TO=

